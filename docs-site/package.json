{
  "name": "passporter-docs-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Delivery layer for the docs/ handbook. Swappable: content lives in ../docs as portable GitHub-flavoured Markdown.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "gen": "node scripts/gen/index.mjs",
    "gen:check": "node scripts/gen/index.mjs --check && node scripts/check-repo.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/ src/lib/",
    "check:render": "node scripts/check-render.mjs",
    "check:dev": "node scripts/check-dev.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "npm test && npm run gen:check && npm run build && npm run check:render",
    "shot": "node scripts/shot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.6",
    "mermaid": "12.3.0",
    "picomatch": "4.0.7",
    "playwright-core": "1.65.0",
    "sharp": "0.35.3",
    "starlight-links-validator": "0.27.0",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  }
}
