{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push -f)",
      "Bash(git push --force)",
      "Bash(git push --force-with-lease)",
      "Bash(git push origin)",
      "Bash(git push -f origin)",
      "Bash(git push --force origin)",
      "Bash(git push --force-with-lease origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * @)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *+main*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main)",
      "Bash(git -C * push *refs/heads/main*)",
      "Bash(git -C * push *+main*)",
      "Bash(git update-ref *refs/heads/main*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -f main*)",
      "Bash(gh api *refs/heads/main*)",
      "Bash(gh api *branches/main*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh auth token*)",
      "Bash(gh auth logout*)",
      "Bash(gh secret *)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf ~)",
      "Bash(rm -fr ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -fr ~/)",
      "Bash(rm -Rf /)",
      "Bash(rm -Rf ~)",
      "Bash(rm -r -f /)",
      "Bash(rm -r -f ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf /home)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /root*)",
      "Bash(rm -rf /srv*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /sbin*)",
      "Bash(rm *--no-preserve-root*)",
      "Bash(herdr server *)",
      "Bash(herdr session stop *)",
      "Bash(herdr session delete *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/passporter/**)",
      "Read(~/.config/gh/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.keystore)",
      "Read(//**/*.jks)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/passporter/**)"
    ]
  }
}
