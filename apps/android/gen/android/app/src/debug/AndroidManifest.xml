<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: post sample notices from adb (docs/development/android.md,
     "Notifications"). DUMP is granted to adb's shell and to no installable
     app, so nothing else on the phone can trigger it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.passporter.notify.SampleNoticeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
