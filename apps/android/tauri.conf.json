{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Passporter",
  "version": "0.1.0",
  "identifier": "dev.passporter.app",
  "build": {
    "frontendDist": "connect"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "../../crates/web/public/icons/icon-512.png"
    ]
  }
}
